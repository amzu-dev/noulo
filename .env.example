# noulo configuration. Copy to .env and edit, or use `noulo config set <key> <value>`.
# Every setting is optional; the values below are the defaults.
# Full reference: docs/configuration.md

# --- server -----------------------------------------------------------------
NOULO_HOST=127.0.0.1                 # loopback only; any other host needs NOULO_ALLOW_NETWORK=true
NOULO_PORT=8787
NOULO_ALLOW_NETWORK=false            # explicit opt-in to bind a LAN/public interface
# NOULO_API_KEY=change-me            # when set, /api/v1/* requires "Authorization: Bearer <key>"
NOULO_UI_ENABLED=true                # serve the frontend at /ui/ (noulo serve runs headless)
NOULO_LOG_LEVEL=info
NOULO_RUN_DIR=data/run               # pidfile + log of the background service

# --- CORS (never "*") -------------------------------------------------------
NOULO_CORS_ENABLED=true
NOULO_CORS_ALLOW_LOCALHOST=true      # http(s)://localhost|127.0.0.1|[::1] on any port
NOULO_CORS_ORIGINS=                  # comma-separated extra origins, e.g. https://app.example.com

# --- models -----------------------------------------------------------------
NOULO_MODEL=nli-deberta-v3-xsmall-int8   # see: noulo model list
NOULO_MODELS_DIR=models
NOULO_MODELS_FILE=models.json        # your OpenAI-compatible endpoints and custom ONNX models
# NOULO_THREADS=4                    # ONNX Runtime intra-op threads (default: runtime decides)

# Shortcut: register one OpenAI-compatible endpoint as model id "openai"
# NOULO_OPENAI_BASE_URL=https://api.openai.com/v1
# NOULO_OPENAI_MODEL=gpt-4o-mini
# NOULO_OPENAI_API_KEY=sk-...

# --- execution --------------------------------------------------------------
NOULO_MAX_CONCURRENCY=1              # parallel inferences
NOULO_MAX_QUEUE=32                   # waiting requests before 503 ENGINE_BUSY
NOULO_SHUTDOWN_TIMEOUT=10            # seconds to drain in-flight requests on stop

# --- request limits ---------------------------------------------------------
NOULO_MAX_INPUT_CHARS=5000
NOULO_MAX_TEXT_CHARS=1000            # proposition / question / option / rubric level
NOULO_MAX_CHOICES=20
NOULO_MAX_RUBRIC_LEVELS=11
NOULO_MAX_BODY_BYTES=65536

# --- learning memory (RAG-style) --------------------------------------------
NOULO_LEARNING_ENABLED=true          # also: noulo learning on|off, PUT /api/v1/learning
NOULO_EMBEDDER=minilm-l6-v2-int8     # or "hashing" (no model), or an OpenAI embedder from models.json
NOULO_MEMORY_STORE=sqlite            # sqlite | qdrant | chroma | your.module:YourStore
NOULO_MEMORY_LOCATION=data/memory.sqlite3   # file/dir for local stores, http(s):// URL for remote ones
NOULO_MEMORY_COLLECTION=noulo_memory # suffixed with the embedder id
# NOULO_MEMORY_API_KEY=              # for remote vector databases
NOULO_MEMORY_TOP_K=8
NOULO_MEMORY_MIN_SIMILARITY=0.80
NOULO_MEMORY_FEEDBACK_WEIGHT=1.0     # weight of verified (feedback) cases
NOULO_MEMORY_OBSERVED_WEIGHT=0.25    # weight of past unverified outputs
NOULO_MEMORY_MAX_INFLUENCE=0.9       # cap on how far memory can move a result
NOULO_MEMORY_PRIOR_STRENGTH=0.5      # evidence needed before memory has much influence
